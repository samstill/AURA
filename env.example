# =============================================================================
# Encresa AURA - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura

# -----------------------------------------------------------------------------
# API Keys - Required for LLM functionality
# At least one provider must be configured for the service to work
# -----------------------------------------------------------------------------

# Google Gemini (recommended for fast responses)
GOOGLE_API_KEY=your_google_api_key

# OpenAI (best for tool calling)
OPENAI_API_KEY=your_openai_api_key

# Groq (fast inference, good fallback)
GROQ_API_KEY=your_groq_api_key

# DeepSeek (alternative provider)
DEEPSEEK_API_KEY=your_deepseek_api_key

# OpenRouter (multi-model gateway)
OPENROUTER_API_KEY=your_openrouter_api_key

# -----------------------------------------------------------------------------
# Model Configuration (defaults in config.py, override here)
# All models can be customized via environment variables
# -----------------------------------------------------------------------------

# Gemini Models
GEMINI_FAST_MODEL=gemini-2.0-flash
GEMINI_SMART_MODEL=gemini-2.0-flash-thinking-exp
EMBEDDING_MODEL=text-embedding-004

# OpenAI Models  
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_SMART_MODEL=gpt-4.1
STALLER_MODEL=gpt-4.1-nano

# Groq Models
GROQ_FAST_MODEL=llama-3.3-70b-versatile
GROQ_SMART_MODEL=llama-3.3-70b-versatile

# OpenRouter Models
OPENROUTER_FAST_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_SMART_MODEL=deepseek/deepseek-r1

# DeepSeek Models
DEEPSEEK_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
# full = act until goal achieved, no confirmations
# half = auto for safe actions, ask before delete/bulk (default)
# minimal = confirm all write operations
AGENT_AUTONOMY=half
AGENT_MAX_ITERATIONS=10

# -----------------------------------------------------------------------------
# Aura Routing Algorithm
# -----------------------------------------------------------------------------
AURA_HARD_TIMEOUT=1.0
AURA_GRACE_PERIOD=0.5
AURA_MAX_ASYNC_WAIT=30.0
AURA_CACHE_TTL=3600
AURA_CACHE_SIMILARITY_THRESHOLD=0.95

# -----------------------------------------------------------------------------
# Vector Store / Supermemory (Portable Architecture)
# -----------------------------------------------------------------------------
# Provider: "supabase" (dev, uses pgvector) or "vertex_ai" (prod, GCP)
VECTOR_STORE_PROVIDER=supabase

# GCP Settings (only needed when VECTOR_STORE_PROVIDER=vertex_ai)
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=us-central1
# VERTEX_INDEX_ENDPOINT=projects/.../locations/.../endpoints/...
# VERTEX_INDEX_ID=your-index-id

# -----------------------------------------------------------------------------
# External Services (Optional)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# TTS (ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_key

# OAuth (Authentik)
AUTHENTIK_BASE_URL=https://auth.example.com
AUTHENTIK_CLIENT_ID=your_client_id
AUTHENTIK_CLIENT_SECRET=your_client_secret
