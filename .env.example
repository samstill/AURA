# =============================================================================
# Project AURA - Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
BASE_URL=http://localhost:30000

# -----------------------------------------------------------------------------
# Authentik IDP (OAuth2/OIDC)
# -----------------------------------------------------------------------------
AUTHENTIK_URL=http://localhost:30080
AUTHENTIK_INTERNAL_URL=http://authentik.aura-auth.svc.cluster.local
AUTHENTIK_CLIENT_ID=your-client-id
AUTHENTIK_CLIENT_SECRET=your-client-secret

# -----------------------------------------------------------------------------
# Session & Security
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/aura
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key

# -----------------------------------------------------------------------------
# LLM Providers (configure at least one)
# -----------------------------------------------------------------------------

# Google Gemini (Primary)
GOOGLE_API_KEY=your-google-api-key
GEMINI_FAST_MODEL=gemini-2.0-flash
GEMINI_SMART_MODEL=gemini-2.0-flash-thinking-exp
EMBEDDING_MODEL=text-embedding-004

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_SMART_MODEL=gpt-4.1
STALLER_MODEL=gpt-4.1-nano

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_FAST_MODEL=llama-3.3-70b-versatile
GROQ_SMART_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_FAST_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_SMART_MODEL=deepseek/deepseek-r1

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
# full = act until goal achieved, no confirmations
# half = auto for safe actions, ask before delete/bulk
# minimal = ask before every write action
AGENT_AUTONOMY=full
AGENT_MAX_ITERATIONS=10

# -----------------------------------------------------------------------------
# Aura Routing Algorithm
# -----------------------------------------------------------------------------
AURA_HARD_TIMEOUT=1.0
AURA_GRACE_PERIOD=0.5
AURA_MAX_ASYNC_WAIT=30.0
AURA_CACHE_TTL=3600
AURA_CACHE_SIMILARITY_THRESHOLD=0.95

# -----------------------------------------------------------------------------
# Integrations
# -----------------------------------------------------------------------------
# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret

# -----------------------------------------------------------------------------
# TTS (Text-to-Speech)
# -----------------------------------------------------------------------------
# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id
ELEVENLABS_MODEL=eleven_turbo_v2_5
TTS_MOCK=false

# Fish Audio
FISH_AUDIO_API_KEY=your-fish-audio-api-key
FISH_AUDIO_VOICE_ID=bf322df2096a46f18c579d0baa36f41d

# Remote TTS Workers (DEV mode - Colab ngrok tunnels)
AURA_ENV=DEV
TTS_WORKER_URL=https://your-tts-worker.ngrok-free.dev
VOICE_WORKER_URL=https://your-voice-worker.ngrok-free.dev
